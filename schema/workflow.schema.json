{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent-learning.local/schema/workflow.schema.json",
  "title": "Hermes skill workflow",
  "description": "Shareable workflow DAG. No policy snapshots or raw episode payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "skill_version", "workflow"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "skill_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skill_version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "template": {
      "type": ["string", "null"]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "nodes", "edges"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "discount_factor": { "type": "number" },
        "metadata": { "type": "object" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "task_id", "action_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "task_id": { "type": "string", "minLength": 1 },
        "action_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "actions_short": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "metadata": { "type": "object" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    }
  }
}
