{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-schema.local/v1.0.0/skill.schema.json",
  "title": "Shareable skill pack",
  "description": "workflow.json envelope. No policy snapshots or raw episodes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "skill_version", "workflow"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "skill_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skill_version": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "template": { "type": ["string", "null"] },
    "workflow": { "$ref": "workflow.schema.json" }
  }
}
