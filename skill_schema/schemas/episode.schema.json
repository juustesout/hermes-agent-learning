{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-schema.local/v1.0.0/episode.schema.json",
  "title": "Learning episode",
  "description": "Store episode. Full training also requires intent_summary, expected_outcome, execution_status, result_summary, and action_id or action_name.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "agent_id", "task_id"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "agent_name": { "type": ["string", "null"] },
    "task_id": { "type": "string", "minLength": 1 },
    "task_name": { "type": ["string", "null"] },
    "intent_summary": { "type": ["string", "null"] },
    "action_type": { "type": ["string", "null"] },
    "action_name": { "type": ["string", "null"] },
    "action_id": { "type": ["string", "null"] },
    "action_logprob": { "type": ["number", "null"] },
    "target": { "type": ["string", "null"] },
    "input_summary": { "type": ["string", "null"] },
    "expected_outcome": { "type": ["string", "null"] },
    "execution_status": { "type": ["string", "null"] },
    "result_summary": { "type": ["string", "null"] },
    "policy_id": { "type": ["string", "null"] },
    "policy_version": { "type": ["integer", "null"] },
    "context_features": { "type": "object" },
    "model_deployment": { "type": ["string", "null"] },
    "correlation_id": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "request_latency_ms": { "type": ["integer", "number", "null"] },
    "metadata": { "type": "object" },
    "created_at": { "type": "string" }
  }
}
